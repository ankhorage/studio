  "bin": {
    "ankhorage-studio-host": "./dist/host/http/standalone.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status",
    "check:expo57-generated-app": "bun run scripts/expo57-generated-app-acceptance.ts",
    "check:expo57-generated-capabilities": "bun run scripts/expo57-generated-capability-acceptance.ts",
    "check:expo57-generated-navigation": "bun run scripts/expo57-generated-navigation-acceptance.ts",
    "check:expo57-native-capability-evidence": "bun run scripts/expo57-native-capability-evidence.ts",
    "check:expo57-studio-standalone": "bun run scripts/expo57-studio-standalone-acceptance.ts",
    "check:packed-studio-host": "bun run scripts/packed-studio-host-acceptance.ts",
    "dev:studio": "bun --cwd apps/studio run start",
    "docs": "paradox generate",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ankhorage/color-theory": "^0.3.0",
    "@ankhorage/contracts": "^8.2.0",
    "@ankhorage/data-sources": "^2.0.0",
    "@ankhorage/deploy": "^0.12.0",
    "@ankhorage/expo-runtime": "^3.2.7",
    "@ankhorage/infra": "^4.1.6",
    "@ankhorage/orchestrator": "^0.3.1",
    "@ankhorage/orchestrator-module-expo-google-fonts": "^0.2.1",
    "@ankhorage/orchestrator-module-expo-localization": "^0.6.0",
    "@ankhorage/permissions": "^0.2.3",
    "@ankhorage/react-native-reanimated-dnd-web": "^0.4.0",
    "@ankhorage/runtime": "^2.2.1",
    "@ankhorage/supabase-auth": "^1.2.7",
    "@ankhorage/supabase-storage": "^0.2.0",
    "@ankhorage/supabase-vault": "^0.2.5",
    "@ankhorage/templates": "^9.1.3",
    "@ankhorage/zora": "^4.0.0",
    "@ankhorage/zora-chess": "^0.1.2",
    "@ankhorage/zora-tabletop": "^0.0.5",
    "@fastify/cors": "^11.2.0",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image-picker": "~57.0.15",
    "fastify": "^5.7.4"
  },
  "peerDependencies": {
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "expo": "57.0.19",
    "expo-constants": "~57.0.17",
    "expo-router": "~57.0.18",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.x",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.8.9",
    "@ankhorage/devtools": "^1.10.5",
    "@ankhorage/paradox": "^0.1.24",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.14",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@ankhorage/contracts": "$@ankhorage/contracts"
  },
  "packageManager": "bun@1.4.0"
}
