{
  "name": "@ankhorage/studio",
  "version": "8.0.5",
  "description": "Studio authoring package for Ankhorage apps",
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/studio#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/studio/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/studio.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/root.js",
  "types": "./dist/root.d.ts",
  "sideEffects": false,
  "files": [
    "apm",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/root.d.ts",
      "import": "./dist/root.js"
    },
    "./apm": {
      "types": "./dist/apm.d.ts",
      "import": "./dist/apm.js"
    },
    "./app": {
      "types": "./dist/app/index.d.ts",
      "import": "./dist/app/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    },
    "./capabilities": {
      "types": "./dist/capabilities/index.d.ts",
      "import": "./dist/capabilities/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./runtime/actionSuppression": {
      "types": "./dist/runtime/actionSuppression.d.ts",
      "import": "./dist/runtime/actionSuppression.js"
    },
    "./runtime/executeStudioRuntimeCapabilityAsync": {
      "types": "./dist/runtime/executeStudioRuntimeCapabilityAsync.d.ts",
      "import": "./dist/runtime/executeStudioRuntimeCapabilityAsync.js"
    },
    "./runtime/useStudioRuntimeCapabilityExecutor": {
      "types": "./dist/runtime/useStudioRuntimeCapabilityExecutor.d.ts",
      "import": "./dist/runtime/useStudioRuntimeCapabilityExecutor.js"
    },
    "./core/StudioContext": {
      "types": "./dist/core/StudioContext.d.ts",
      "import": "./dist/core/StudioContext.js"
    },
    "./core/StudioProvider": {
      "types": "./dist/core/StudioProvider.d.ts",
      "import": "./dist/core/StudioProvider.js"
    },
    "./core/studioPackageBoundary": {
      "types": "./dist/core/studioPackageBoundary.d.ts",
      "import": "./dist/core/studioPackageBoundary.js"
    },
    "./ui/AnkhStudio": {
      "types": "./dist/ui/AnkhStudio.d.ts",
      "import": "./dist/ui/AnkhStudio.js"
    },
    "./ui/useStudioAppBarAugmentation": {
      "types": "./dist/ui/useStudioAppBarAugmentation.d.ts",
      "import": "./dist/ui/useStudioAppBarAugmentation.js"
    },
    "./utils/treeUtils": {
      "types": "./dist/utils/treeUtils.d.ts",
      "import": "./dist/utils/treeUtils.js"
    },
    "./canvasDragModel": {
      "types": "./dist/canvasDragModel.d.ts",
      "import": "./dist/canvasDragModel.js"
    },
    "./canvasDropZones": {
      "types": "./dist/canvasDropZones.d.ts",
      "import": "./dist/canvasDropZones.js"
    },
    "./insertModalModel": {
      "types": "./dist/insertModalModel.d.ts",
      "import": "./dist/insertModalModel.js"
    },
    "./manifestState": {
      "types": "./dist/manifestState.d.ts",
      "import": "./dist/manifestState.js"
    },
    "./bindingAuthoringModel": {
      "types": "./dist/bindingAuthoringModel.d.ts",
      "import": "./dist/bindingAuthoringModel.js"
    },
    "./propertiesAuthoringModel": {
      "types": "./dist/propertiesAuthoringModel.d.ts",
      "import": "./dist/propertiesAuthoringModel.js"
    },
    "./manifestSync": {
      "types": "./dist/manifestSync.d.ts",
      "import": "./dist/manifestSync.js"
    },
    "./projectAuthHealth": {
      "types": "./dist/projectAuthHealth.d.ts",
      "import": "./dist/projectAuthHealth.js"
    },
    "./projectSecretUsage": {
      "types": "./dist/projectSecretUsage.d.ts",
      "import": "./dist/projectSecretUsage.js"
    },
    "./routeUtils": {
      "types": "./dist/routeUtils.d.ts",
      "import": "./dist/routeUtils.js"
    },
    "./runtimeDiagnosticsModel": {
      "types": "./dist/runtimeDiagnosticsModel.d.ts",
      "import": "./dist/runtimeDiagnosticsModel.js"
    },
    "./studioAdminRouteModel": {
      "types": "./dist/studioAdminRouteModel.d.ts",
      "import": "./dist/studioAdminRouteModel.js"
    },
    "./studioSelectionModel": {
      "types": "./dist/studioSelectionModel.d.ts",
      "import": "./dist/studioSelectionModel.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "import": "./dist/host/index.js"
    },
    "./externalApiAuthoring": {
      "types": "./dist/externalApiAuthoring/index.d.ts",
      "import": "./dist/externalApiAuthoring/index.js"
    },
    "./administration/AnkhAdminPage": {
      "types": "./dist/ui/admin/AnkhAdminPage.d.ts",
      "import": "./dist/ui/admin/AnkhAdminPage.js"
    },
    "./administration/StudioAdminAccessGate": {
      "types": "./dist/features/administration/adapters/inbound/StudioAdminAccessGate.d.ts",
      "import": "./dist/features/administration/adapters/inbound/StudioAdminAccessGate.js"
    },
    "./administration/useStudioAdminWorkspace": {
      "types": "./dist/features/administration/adapters/inbound/useStudioAdminWorkspace.d.ts",
      "import": "./dist/features/administration/adapters/inbound/useStudioAdminWorkspace.js"
    }
  },
  "ankh": {
    "category": "studio",
    "provider": "./dist/cli/index.js",
    "capabilities": [
      {
        "id": "studio.dev",
        "owner": "@ankhorage/studio",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Start Studio development",
        "description": "Start the local Studio host and first-party Studio app."
      },
      {
        "id": "studio.projects.list",
        "owner": "@ankhorage/studio",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "List Studio projects",
        "description": "List projects in the Studio workspace."
      },
      {
        "id": "studio.projects.create",
        "owner": "@ankhorage/studio",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Create Studio project",
        "description": "Create a Studio project from a template."
      },
      {
        "id": "studio.projects.delete",
        "owner": "@ankhorage/studio",
        "access": [
          "invoke"
        ],
        "binding": {
          "kind": "action",
          "bindableAs": [
            "target"
          ]
        },
        "label": "Delete Studio project",
        "description": "Delete a Studio project."
      }
    ],
    "apm": {
      "protocolVersion": 1,
      "descriptor": "./apm/update.json"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "bun run check-types",
    "dev": "bun run --no-orphans dev:host & bun run --no-orphans dev:studio",
    "dev:studio": "bun install --cwd apps/studio --frozen-lockfile && bun run --cwd apps/studio web",
    "typecheck:studio": "bun install --cwd apps/studio --frozen-lockfile && bun run --cwd apps/studio typecheck",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "test": "bun test src test --path-ignore-patterns '**/*.e2e.test.ts' --path-ignore-patterns '**/*.smoke.test.ts'",
    "test:acceptance:expo57-generated-app": "bun scripts/expo57-generated-app-acceptance.ts",
    "test:acceptance:expo57-generated-capabilities": "bun scripts/expo57-generated-capability-acceptance.ts",
    "test:acceptance:expo57-auth-hidden-route-drawer": "bun scripts/expo57-generated-navigation-acceptance.ts --auth-hidden-route-drawer",
    "test:acceptance:expo57-generated-navigation": "bun scripts/expo57-generated-navigation-acceptance.ts",
    "test:acceptance:expo57-sharkprey": "bun scripts/expo57-sharkprey-acceptance.ts",
    "test:acceptance:expo57-studio-standalone": "bun scripts/expo57-studio-standalone-acceptance.ts",
    "test:acceptance:packed-studio-host": "bun scripts/packed-studio-host-acceptance.ts",
    "test:e2e": "bun run test:e2e:generated-app-web && bun run test:e2e:infra",
    "test:e2e:generated-app-web": "CHROME_PATH=\"${CHROME_PATH:-$(command -v google-chrome || command -v google-chrome-stable || command -v chromium || command -v chromium-browser || printf '%s' '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome')}\" ANKH_STUDIO_ADMIN_WEB_SMOKE=1 bun test src/host/generatedAdminExpoWeb.smoke.test.ts",
    "test:e2e:infra": "ANKH_STUDIO_INFRA_E2E=1 bun test src/host/studioInfra.e2e.test.ts",
    "test:e2e:nutrition-api": "ANKH_STUDIO_NUTRITION_API_E2E=1 bun test src/host/generatedNutritionApi.e2e.test.ts",
    "test:e2e:generated-oauth": "ANKH_STUDIO_GENERATED_OAUTH_E2E=1 bun test src/host/generatedOAuthLifecycle.e2e.test.ts",
    "test:e2e:generated-native-oauth": "ANKH_STUDIO_GENERATED_NATIVE_OAUTH_E2E=1 bun test src/host/generatedNativeOAuthLifecycle.e2e.test.ts",
    "test:e2e:expo57-production-infra": "ANKH_STUDIO_EXPO57_INFRA_E2E=1 bun test src/host/expo57GeneratedProductionInfra.e2e.test.ts",
    "test:smoke:studio-web": "ANKH_STUDIO_WORKSPACE_WEB_SMOKE=1 bun test src/host/studioWorkspaceExpoWeb.smoke.test.ts",
    "test:smoke:generated-auth-runtime": "ANKH_STUDIO_GENERATED_AUTH_RUNTIME_SMOKE=1 bun test src/host/generatedAuthAdapterRuntime.smoke.test.ts",
    "test:smoke:oauth-fixture-consumer": "ANKH_STUDIO_OAUTH_FIXTURE_CONSUMER_SMOKE=1 bun test src/host/oauthFixtureConsumer.smoke.test.ts",
    "test:smoke:android-run-template": "ANKH_STUDIO_ANDROID_RUN_TEMPLATE_SMOKE=1 bun test src/host/orchestrator/androidRunTemplate.smoke.test.ts",
    "test:smoke:auth5-native-fixture": "ANKH_STUDIO_AUTH5_NATIVE_FIXTURE_SMOKE=1 bun test test/smoke/createAuth5NativeOAuthSmokeFixture.smoke.test.ts",
    "smoke:auth5-native:prepare": "bun scripts/auth5-native-oauth-smoke.ts",
    "smoke:auth5-native:infra": "bun scripts/auth5-native-oauth-smoke-infra.ts",
    "smoke:expo57-native": "bun scripts/expo57-native-capability-evidence.ts",
    "docs": "paradox",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version",
    "dev:host": "bun src/host/http/standalone.ts",
    "test:host-smoke": "ANKH_STUDIO_HOST_SMOKE=1 bun test src/host/hostLifecycle.smoke.test.ts",
    "knip:check": "ankhorage-knip",
    "test:apm": "bun test src/features/project-updates/adapters/inbound/studioUpdateExtension.test.ts",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "test:apm:consumer": "node scripts/apm-owner-consumer.ts",
    "test:e2e:fresh-template-infra": "ANKH_STUDIO_FRESH_TEMPLATE_INFRA_E2E=1 bun test src/host/freshTemplateInfra.e2e.test.ts",
    "test:acceptance:expo57-social-template-web": "bun scripts/expo57-social-template-web-acceptance.ts"
  },
  "keywords": [
    "ankhorage",
    "studio",
    "authoring",
    "react-native",
    "app-builder",
    "oauth",
    "secret-store",
    "supabase-vault"
  ],
  "dependencies": {
    "@ankhorage/apm": "^0.8.15",
    "@ankhorage/auth": "^0.1.3",
    "@ankhorage/auth-supabase": "^2.0.5",
    "@ankhorage/capability": "^0.2.2",
    "@ankhorage/color-theory": "^0.3.1",
    "@ankhorage/contracts": "^26.2.0",
    "@ankhorage/data-sources": "^2.1.4",
    "@ankhorage/deploy": "^0.14.11",
    "@ankhorage/expo-runtime": "^7.0.2",
    "@ankhorage/infra": "^7.2.12",
    "@ankhorage/local": "^0.3.24",
    "@ankhorage/minikube": "^0.4.126",
    "@ankhorage/navigator": "^3.5.13",
    "@ankhorage/orchestrator": "^0.4.5",
    "@ankhorage/orchestrator-module-expo-google-fonts": "^0.2.23",
    "@ankhorage/orchestrator-module-expo-localization": "^0.7.3",
    "@ankhorage/permissions": "^0.3.9",
    "@ankhorage/react-native-reanimated-dnd-web": "^0.4.4",
    "@ankhorage/repository": "^0.6.13",
    "@ankhorage/runtime": "^5.1.2",
    "@ankhorage/supabase": "^0.5.14",
    "@ankhorage/storage": "^0.2.2",
    "@ankhorage/storage-supabase": "^1.0.0",
    "@ankhorage/surface": "^9.4.12",
    "@ankhorage/secrets": "^0.3.1",
    "@ankhorage/secrets-supabase-vault": "^1.0.0",
    "@ankhorage/templates": "^12.3.1",
    "@ankhorage/utility": "^1.10.0",
    "@ankhorage/zora": "^25.10.0",
    "@fastify/cors": "^11.3.1",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "fastify": "^5.12.7"
  },
  "peerDependencies": {
    "@react-native-vector-icons/fontawesome": "^13.1.4 || ^14.0.0",
    "@react-native-vector-icons/fontawesome5": "^13.1.4 || ^14.0.0",
    "@react-native-vector-icons/fontawesome6": "^13.1.4 || ^14.0.0",
    "@react-native-vector-icons/ionicons": "^13.1.4 || ^14.0.0",
    "expo": "57.0.31",
    "expo-constants": "~57.0.22",
    "expo-router": "~57.0.29",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.x",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.3",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.13.1",
    "@ankhorage/devtools": "^2.3.21",
    "@ankhorage/paradox": "^0.3.5",
    "@types/bun": "^1.4.2",
    "@types/node": "^24.13.3",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@ankhorage/contracts": "$@ankhorage/contracts"
  },
  "packageManager": "bun@1.4.2"
}
