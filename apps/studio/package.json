{
  "name": "@ankhorage/studio-app",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "bun run typecheck",
    "typecheck": "bun run router:types && tsc --noEmit -p tsconfig.json",
    "router:types": "node scripts/generate-router-types.mjs",
    "platform:check": "node scripts/assert-platform.mjs",
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "doctor": "expo-doctor",
    "expo:check": "expo install --check",
    "compiler:healthcheck": "react-compiler-healthcheck",
    "export:web": "expo export --platform web --output-dir dist",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "prebuild": "expo prebuild --clean --no-install"
  },
  "dependencies": {
    "@ankhorage/expo-runtime": "^3.2.12",
    "@ankhorage/studio": "^2.4.5",
    "@expo/metro-runtime": "~57.0.15",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "expo": "57.0.20",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-font": "~57.0.3",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.19",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@ankhorage/ankh": "^0.8.11",
    "@ankhorage/devtools": "^1.14.0",
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "expo-doctor": "1.20.4",
    "react-compiler-healthcheck": "1.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@ankhorage/repository": "0.4.4"
  }
}
