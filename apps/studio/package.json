{
  "name": "@ankhorage/studio-app",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "bun@1.3.14",
  "scripts": {
    "build": "bun run type-check",
    "type-check": "bun run router:types && tsc --noEmit -p tsconfig.json",
    "router:types": "node scripts/generate-router-types.mjs",
    "platform:check": "node scripts/assert-platform.mjs",
    "start": "expo start --dev-client",
    "web": "expo start --web",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "doctor": "expo-doctor",
    "expo:check": "expo install --check",
    "compiler:healthcheck": "react-compiler-healthcheck",
    "export:web": "expo export --platform web --output-dir dist",
    "export:android": "expo export --platform android --output-dir dist-android",
    "export:ios": "expo export --platform ios --output-dir dist-ios",
    "prebuild": "expo prebuild --clean --no-install"
  },
  "dependencies": {
    "@ankhorage/expo-runtime": "^3.0.12",
    "@ankhorage/studio": "^2.0.9",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "expo": "57.0.18",
    "expo-constants": "~57.0.16",
    "expo-dev-client": "~57.0.16",
    "expo-font": "~57.0.2",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^1.8.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "expo-doctor": "1.20.4",
    "react-compiler-healthcheck": "1.0.0",
    "typescript": "~6.0.3"
  }
}
