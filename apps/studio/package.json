{
  "name": "@ankhorage/studio-app",
  "main": "expo-router/entry",
  "version": "1.0.1",
  "private": true,
  "_comment": "Keep @ankhorage/studio on the published package. Generated apps are moving standalone; do not restore file:../.. here.",
  "scripts": {
    "prepare:root-package": "bun run --cwd ../.. build",
    "build": "bun run prepare:root-package && bun x tsc -p tsconfig.json",
    "type-check": "bun run prepare:root-package && bun x tsc -p tsconfig.json",
    "start": "bun run prepare:root-package && expo start",
    "web": "bun run prepare:root-package && expo start --web",
    "android": "bun run prepare:root-package && expo start --android",
    "ios": "bun run prepare:root-package && expo start --ios",
    "lint": "expo lint",
    "export:web": "bun run prepare:root-package && expo export --platform web --output-dir dist-web"
  },
  "dependencies": {
    "@ankhorage/studio": "latest",
    "@react-native-picker/picker": "2.11.4",
    "@react-native-vector-icons/fontawesome": "^13.1.3",
    "@react-native-vector-icons/fontawesome5": "^13.1.3",
    "@react-native-vector-icons/fontawesome6": "^13.1.3",
    "@react-native-vector-icons/ionicons": "^13.1.3",
    "expo": "~57.0.15",
    "expo-constants": "~57.0.13",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  }
}
